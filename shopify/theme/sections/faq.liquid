<section class="section">
  <div class="page-width" style="max-width: 88rem;">
    <div class="section-header section-header--center reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div itemscope itemtype="https://schema.org/FAQPage">
      {%- for block in section.blocks -%}
        <details class="faq-item reveal" {{ block.shopify_attributes }} itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <summary itemprop="name">{{ block.settings.question }}</summary>
          <div class="faq-item__body" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text">{{ block.settings.answer }}</p>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I take BIO N:OV?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Follow the directions on the label. The standard suggestion is one 500 mg tablet, three times per day, with water." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "What is BIO N:OV?", "answer": "BIO N:OV is a third-generation nitric oxide support supplement made in Korea using a patented microbial fermentation process. Each box contains 60 tablets of 500 mg." } },
        { "type": "faq", "settings": { "question": "How do I take it?", "answer": "Follow the label directions: one tablet, three times per day, with water. One box is a 20-day supply at the standard serving." } },
        { "type": "faq", "settings": { "question": "What are the ingredients?", "answer": "Fermented garlic extract, fermented lettuce extract, soybean and soybean sprouts — transformed by a patented Korean fermentation process (KACC91554P)." } },
        { "type": "faq", "settings": { "question": "Is it safe to take with my medication?", "answer": "If you are pregnant, nursing, taking any medication or managing a medical condition, please consult your healthcare professional before use." } },
        { "type": "faq", "settings": { "question": "Where do you ship?", "answer": "We ship worldwide with tracked delivery from our Singapore fulfillment hub, with regional hubs serving Malaysia and Korea-based fulfillment for the US and Europe." } },
        { "type": "faq", "settings": { "question": "What is your return policy?", "answer": "We offer a 30-day satisfaction guarantee on unopened products. See our Refund Policy for full details." } }
      ]
    }
  ]
}
{% endschema %}
