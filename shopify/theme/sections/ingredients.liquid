<section class="section">
  <div class="page-width">
    <div class="section-header section-header--center reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="grid grid--4">
      {%- for block in section.blocks -%}
        <div class="glass-card reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="product-card__media">
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600' }}
            </div>
          {%- endif -%}
          <h3 style="font-size: 1.8rem;">{{ block.settings.title }}</h3>
          <p style="font-size: 1.4rem;">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside every tablet" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four ingredients. Nothing hidden." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Naturally derived botanicals transformed by patented Korean fermentation technology." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Name", "default": "Fermented garlic extract" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "A traditional botanical, transformed by fermentation." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "title": "Fermented garlic extract", "text": "Garlic's storied wellness profile, refined through patented microbial fermentation." } },
        { "type": "ingredient", "settings": { "title": "Fermented lettuce extract", "text": "An unexpected hero — lettuce extract fermented to unlock its natural compounds." } },
        { "type": "ingredient", "settings": { "title": "Soybean", "text": "A plant-protein staple of Korean nutrition, supporting the formulation base." } },
        { "type": "ingredient", "settings": { "title": "Soybean sprouts", "text": "Sprouted soybeans bring their own distinct micronutrient profile." } }
      ]
    }
  ]
}
{% endschema %}
