<section class="section">
  <div class="page-width">
    <div class="section-header section-header--center reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="grid grid--3">
      {%- for block in section.blocks -%}
        <div class="glass-card benefit-card reveal" {{ block.shopify_attributes }}>
          <span class="benefit-card__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why BIO N:OV" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed to support your whole system" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "zap", "label": "Energy" },
            { "value": "shield", "label": "Shield" },
            { "value": "brain", "label": "Brain" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "flask", "label": "Flask" }
          ],
          "default": "heart"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Circulation support" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Formulated to support healthy blood flow and vascular function as part of a balanced lifestyle." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "heart", "title": "Circulation & balance", "text": "Formulated to support healthy circulation and cardiovascular balance as part of a healthy lifestyle." } },
        { "type": "benefit", "settings": { "icon": "zap", "title": "Vigor & energy", "text": "Designed to support natural energy production and daily vitality — so you can keep up with life." } },
        { "type": "benefit", "settings": { "icon": "shield", "title": "Immune support", "text": "Fermented botanical extracts chosen to help maintain the body's natural defenses." } },
        { "type": "benefit", "settings": { "icon": "brain", "title": "Cognition & clarity", "text": "Healthy circulation matters for the mind too. BIO N:OV supports cognitive wellness from within." } },
        { "type": "benefit", "settings": { "icon": "leaf", "title": "Naturally derived", "text": "Fermented garlic, fermented lettuce, soybean and soybean sprout — no harsh synthetics." } },
        { "type": "benefit", "settings": { "icon": "flask", "title": "Patented science", "text": "A patented microbial fermentation process developed with Korean university researchers." } }
      ]
    }
  ]
}
{% endschema %}
