<section class="section">
  <div class="page-width">
    <div class="section-header reveal">
      <span class="eyebrow">Collection</span>
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', card_product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav style="margin-top: 4.8rem; text-align: center;" aria-label="Pagination">
            {%- if paginate.previous -%}<a class="btn btn--secondary" href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
            {%- if paginate.next -%}<a class="btn btn--secondary" href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p>No products found in this collection yet.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": []
}
{% endschema %}
