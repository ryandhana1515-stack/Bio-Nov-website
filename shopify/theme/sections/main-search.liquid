<section class="section">
  <div class="page-width">
    <div class="section-header">
      <h1>{{ 'search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter-form" style="margin: 2.4rem 0 0;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" style="flex: 1 1 26rem; padding: 1.6rem 2rem; font-size: 1.5rem; color: var(--color-text); background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 999px;">
        <button type="submit" class="btn btn--primary">{{ 'general.search' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <div class="collection-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item %}
            {%- else -%}
              <div class="glass-card">
                <h3 style="font-size: 1.6rem;"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                <p style="font-size: 1.3rem;">{{ item.content | strip_html | truncate: 120 }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>{{ 'search.no_results' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
