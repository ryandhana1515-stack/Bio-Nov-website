{%- assign featured = all_products[section.settings.product] -%}
<section class="section">
  <div class="page-width">
    <div class="hero__inner">
      <div class="hero__media reveal">
        {%- if featured.featured_image != blank -%}
          {{ featured.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 1000', sizes: '(min-width: 990px) 45vw, 100vw' }}
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="hero__content reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | default: featured.title }}</h2>
        <p class="hero__lead">{{ section.settings.text }}</p>

        {%- if featured != blank -%}
          <p class="product__price">{{ featured.price | money }}</p>
          <div class="hero__ctas">
            <a href="{{ featured.url }}" class="btn btn--primary">{{ section.settings.cta_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The flagship" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BIO N:OV — 500 mg × 60 tablets" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One box. Twenty days of third-generation nitric oxide support, born from patented Korean fermentation science." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop BIO N:OV" }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
