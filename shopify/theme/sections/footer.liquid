<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div>
        <a href="{{ routes.root_url }}" class="site-header__logo">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="150" height="44">
          {%- else -%}
            BIOEXCELA<em>&nbsp;GLOBAL</em>
          {%- endif -%}
        </a>
        <p style="margin-top: 2rem; max-width: 36ch;">{{ section.settings.brand_text }}</p>
        <div class="trust-strip" style="justify-content: flex-start; margin-top: 2rem;">
          <span class="trust-strip__item">{% render 'icon', name: 'shield' %} GMP Certified</span>
          <span class="trust-strip__item">{% render 'icon', name: 'globe' %} Ships Worldwide</span>
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <a href="{{ policy.url }}" style="margin-left: 1.6rem;">{{ policy.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </span>
    </div>

    {%- if settings.footer_disclaimer != blank -%}
      <p class="site-footer__disclaimer">{{ settings.footer_disclaimer }}</p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand statement",
      "default": "A premium global wellness brand. Official distribution of BIO N:OV — advanced Korean fermentation science for daily vitality."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "presets": [
    { "name": "Footer", "blocks": [{ "type": "menu" }, { "type": "menu" }, { "type": "menu" }] }
  ]
}
{% endschema %}
