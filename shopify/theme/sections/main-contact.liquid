<section class="section">
  <div class="page-width" style="max-width: 72rem;">
    <div class="section-header">
      <span class="eyebrow">Contact</span>
      <h1>{{ page.title }}</h1>
      <div class="rte">{{ page.content }}</div>
    </div>

    {%- form 'contact', class: 'glass-card' -%}
      {%- if form.posted_successfully? -%}
        <p style="color: var(--color-accent);">Thank you — we will get back to you within one business day.</p>
      {%- endif -%}

      <div class="field">
        <label for="ContactName">Name</label>
        <input type="text" id="ContactName" name="contact[name]" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="ContactEmail">Email</label>
        <input type="email" id="ContactEmail" name="contact[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="ContactSubject">Subject</label>
        <input type="text" id="ContactSubject" name="contact[subject]">
      </div>
      <div class="field">
        <label for="ContactMessage">Message</label>
        <textarea id="ContactMessage" name="contact[body]" rows="6" required></textarea>
      </div>
      <button type="submit" class="btn btn--primary">Send message</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": []
}
{% endschema %}
