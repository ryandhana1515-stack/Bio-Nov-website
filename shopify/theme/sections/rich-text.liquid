<section class="section">
  <div class="page-width" style="max-width: 80rem;">
    <div class="{% if section.settings.center %}text-center{% endif %} reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" {% if section.settings.center %}style="justify-content:center;"{% endif %}>{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn btn--secondary" style="margin-top: 2rem;">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share your brand story, mission or credibility statement here.</p>" },
    { "type": "checkbox", "id": "center", "label": "Center align", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
