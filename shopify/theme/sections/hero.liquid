<section class="hero">
  <div class="page-width">
    <div class="hero__inner">
      <div class="hero__content reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1>{{ section.settings.heading }}</h1>
        <p class="hero__lead">{{ section.settings.subheading }}</p>

        <div class="hero__ctas">
          {%- if section.settings.cta_primary_label != blank -%}
            <a href="{{ section.settings.cta_primary_link }}" class="btn btn--primary">{{ section.settings.cta_primary_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}
            <a href="{{ section.settings.cta_secondary_link }}" class="btn btn--secondary">{{ section.settings.cta_secondary_label }}</a>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="hero__stats">
            {%- for block in section.blocks -%}
              <div class="hero__stat" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.value }}</strong>
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hero__media reveal">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', widths: '550, 800, 1100', sizes: '(min-width: 990px) 45vw, 100vw' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Third-generation nitric oxide science" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feel the difference. <span>Fast.</span>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "BIO N:OV — a patented Korean fermentation breakthrough designed to support healthy circulation, energy and vitality. GMP-certified, naturally derived, made for everyone." },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary button label", "default": "Shop BIO N:OV" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary button link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button label", "default": "Explore the science" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "3rd Gen" },
        { "type": "text", "id": "label", "label": "Label", "default": "NO technology" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "3rd Gen", "label": "Nitric oxide technology" } },
        { "type": "stat", "settings": { "value": "GMP", "label": "Certified Korean facility" } },
        { "type": "stat", "settings": { "value": "Patented", "label": "Fermentation process" } }
      ]
    }
  ]
}
{% endschema %}
