{%- comment -%} Usage: {% render 'product-card', card_product: product %} {%- endcomment -%}
<div class="glass-card product-card">
  <div class="product-card__media">
    {%- if card_product.compare_at_price > card_product.price -%}
      <span class="product-card__badge">Save {{ card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price }}%</span>
    {%- endif -%}
    <a href="{{ card_product.url }}">
      {%- if card_product.featured_image != blank -%}
        {{ card_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', alt: card_product.title }}
      {%- else -%}
        {{ 'product-3' | placeholder_svg_tag }}
      {%- endif -%}
    </a>
  </div>
  <h3 class="product-card__title"><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>
  <p style="font-size: 1.3rem;">{{ card_product.metafields.custom.tagline | default: card_product.vendor }}</p>
  <div class="product-card__price">{% render 'price', price_product: card_product %}</div>
</div>
