{% comment %}
  S7 · How It Works — motion moment M4.
  Molecule-field video plus a live particle canvas (capped at 30fps, paused
  off-screen, disabled on save-data / <4 cores). A three-step flow diagram
  draws its connecting line as you scroll, beside the fermentation lab clip
  in a rounded glass frame.
{% endcomment %}

<section class="bgx-section bgx-section--glow bgx-mech">
  {% render 'bgx-video-bg',
    mp4: section.settings.field_mp4,
    webm: section.settings.field_webm,
    poster: section.settings.field_poster,
    opacity: section.settings.field_opacity,
    scrim: 'flat'
  %}

  <canvas class="bgx-mech__canvas" data-bgx-particles aria-hidden="true"></canvas>

  <div class="bgx-wrap">
    <div class="bgx-mech__grid">
      <div class="bgx-mech__copy">
        <span class="bgx-eyebrow bgx-reveal">{{ section.settings.eyebrow }}</span>
        <h2 class="bgx-h2" data-bgx-split>{{ section.settings.heading }}</h2>
        <p class="bgx-lead bgx-reveal" data-bgx-delay="0.1">{{ section.settings.body }}</p>

        <ol class="bgx-mech__steps">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <li
                class="bgx-mech__step bgx-reveal"
                data-bgx-delay="{{ forloop.index0 | times: 0.12 | plus: 0.15 }}"
                {{ block.shopify_attributes }}
              >
                <span class="bgx-mech__num">{{ forloop.index }}</span>
                <div>
                  <h3 class="bgx-mech__step-title">{{ block.settings.title }}</h3>
                  {%- if block.settings.body != blank -%}
                    <p class="bgx-mech__step-body">{{ block.settings.body }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>

      <figure class="bgx-mech__lab bgx-reveal" data-bgx-delay="0.2">
        {% render 'bgx-video-bg',
          mp4: section.settings.lab_mp4,
          webm: section.settings.lab_webm,
          poster: section.settings.lab_poster,
          opacity: 100,
          scrim: 'none'
        %}
        {%- if section.settings.lab_caption != blank -%}
          <figcaption>{{ section.settings.lab_caption }}</figcaption>
        {%- endif -%}
      </figure>
    </div>
  </div>
</section>

{% stylesheet %}
  .bgx-mech {
    position: relative;
  }

  .bgx-mech__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .bgx-mech__grid {
    display: grid;
    gap: clamp(30px, 5vw, 60px);
    grid-template-columns: 1fr;
    align-items: center;
  }

  .bgx-mech__steps {
    list-style: none;
    counter-reset: none;
    margin: clamp(28px, 4vw, 44px) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    position: relative;
  }

  .bgx-mech__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
    position: relative;
    padding-bottom: 26px;
  }

  .bgx-mech__step:last-child {
    padding-bottom: 0;
  }

  /* The connecting line grows in as each step reveals. */
  .bgx-mech__step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 44px;
    bottom: 6px;
    width: 2px;
    border-radius: 2px;
    background: var(--bgx-gradient);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.8s var(--bgx-ease-out) 0.15s;
  }

  .bgx-mech__step.bgx-revealed:not(:last-child)::before {
    transform: scaleY(1);
  }

  .bgx-mech__num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex: none;
    font-family: var(--bgx-font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--bgx-void);
    background: var(--bgx-gradient);
    box-shadow: var(--bgx-bloom);
  }

  .bgx-mech__step-title {
    font-family: var(--bgx-font-display);
    font-size: 1.06rem;
    font-weight: 600;
    color: var(--bgx-white);
    margin: 0.45rem 0 0.3rem;
  }

  .bgx-mech__step-body {
    margin: 0;
    font-size: 0.94rem;
    color: var(--bgx-mist-strong);
  }

  .bgx-mech__lab {
    position: relative;
    margin: 0;
    border-radius: var(--bgx-radius);
    border: 1px solid var(--bgx-glass-border);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    min-height: 320px;
    box-shadow: var(--bgx-bloom-lg);
  }

  /* The video snippet is absolutely positioned; give it a stacking context. */
  .bgx-mech__lab .bgx-videobg {
    z-index: 0;
  }

  .bgx-mech__lab figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 34px 22px 18px;
    font-size: 0.85rem;
    color: var(--bgx-mist-strong);
    background: linear-gradient(180deg, transparent, rgba(5, 7, 14, 0.9));
  }

  @media (min-width: 900px) {
    .bgx-mech__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BGX Mechanism",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    { "type": "header", "content": "Molecule field background" },
    { "type": "text", "id": "field_mp4", "label": "Video URL (MP4)", "info": "Slot: molecule-field." },
    { "type": "text", "id": "field_webm", "label": "Video URL (WebM, optional)" },
    { "type": "image_picker", "id": "field_poster", "label": "Poster image" },
    {
      "type": "range",
      "id": "field_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 35,
      "unit": "%",
      "label": "Video opacity"
    },
    { "type": "header", "content": "Fermentation lab clip" },
    { "type": "text", "id": "lab_mp4", "label": "Video URL (MP4)", "info": "Slot: fermentation-lab." },
    { "type": "text", "id": "lab_webm", "label": "Video URL (WebM, optional)" },
    { "type": "image_picker", "id": "lab_poster", "label": "Poster image" },
    {
      "type": "text",
      "id": "lab_caption",
      "label": "Caption",
      "default": "Microbial fermentation, Korea"
    },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT WORKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Patented Microbial Fermentation" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "BIO N:OV is produced from a proprietary microbial strain (KACC91554P) held by the Korea Research Institute of Bioscience and Biotechnology, fermenting natural vegetables and herbs into a stable, bioavailable NO precursor."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fermented extract meets stomach acid" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "step", "settings": { "title": "Fermented extract meets stomach acid" } },
      { "type": "step", "settings": { "title": "NO released instantly, no enzyme required" } },
      { "type": "step", "settings": { "title": "Vessels relax, circulation improves" } }
    ]
  },
  "presets": [{ "name": "BGX Mechanism" }]
}
{% endschema %}
