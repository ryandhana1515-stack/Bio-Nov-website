{% comment %}
  BIO N:OV — flexible content section for the Science / About / Affiliates
  pages. Blocks: heading, rich text, feature cards, stat row, CTA.
  Keeps the brand surface consistent without a page builder.
{% endcomment %}

{%- liquid
  assign bg = 'bgx-section--void'
  if section.settings.background == 'navy'
    assign bg = 'bgx-section--navy'
  elsif section.settings.background == 'glow'
    assign bg = 'bgx-section--glow'
  endif
-%}

<section class="bgx-section {{ bg }}">
  <div class="bgx-wrap{% if section.settings.narrow %} bgx-wrap--narrow{% endif %}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="{% if section.settings.center %}bgx-center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="bgx-eyebrow bgx-reveal">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bgx-h2" data-bgx-split>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.center -%}
          <span class="bgx-underline bgx-underline--center bgx-reveal"></span>
        {%- else -%}
          <span class="bgx-underline bgx-reveal"></span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign cards = section.blocks | where: 'type', 'card' -%}
    {%- assign stats = section.blocks | where: 'type', 'stat' -%}

    <div class="bgx-content__body">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <div class="bgx-content__rte bgx-reveal" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'cta' -%}
            <div class="bgx-btn-row bgx-reveal" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link }}" class="bgx-btn bgx-btn--lg" data-bgx-magnetic>
                {{- block.settings.text -}}
              </a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if stats.size > 0 -%}
      <div class="bgx-content__stats">
        {%- for block in stats -%}
          <div class="bgx-reveal" data-bgx-delay="{{ forloop.index0 | times: 0.08 }}" {{ block.shopify_attributes }}>
            {% render 'bgx-counter',
              to: block.settings.value,
              decimals: block.settings.decimals,
              prefix: block.settings.prefix,
              suffix: block.settings.suffix,
              label: block.settings.label,
              size: 'lg'
            %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if cards.size > 0 -%}
      <div class="bgx-grid bgx-content__cards">
        {%- for block in cards -%}
          <article class="bgx-card bgx-reveal" data-bgx-delay="{{ forloop.index0 | times: 0.08 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="bgx-icon">{% render 'bgx-icon', name: block.settings.icon %}</div>
            {%- endif -%}
            <h3 class="bgx-card__title">{{ block.settings.title }}</h3>
            <p class="bgx-card__body">{{ block.settings.body }}</p>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .bgx-content__body {
    margin-top: clamp(24px, 4vw, 40px);
  }

  .bgx-content__rte {
    color: var(--bgx-mist-strong);
    font-size: var(--bgx-lead);
    line-height: 1.7;
  }

  .bgx-content__rte h3 {
    font-family: var(--bgx-font-display);
    font-size: var(--bgx-h3);
    font-weight: 600;
    color: var(--bgx-white);
    margin: 2rem 0 0.7rem;
  }

  .bgx-content__rte a {
    color: var(--bgx-cyan);
  }

  .bgx-content__rte ul,
  .bgx-content__rte ol {
    padding-left: 1.3em;
  }

  .bgx-content__rte li {
    margin-bottom: 0.5rem;
  }

  .bgx-content__stats {
    display: grid;
    gap: clamp(20px, 3vw, 34px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    margin-top: clamp(32px, 5vw, 50px);
  }

  .bgx-content__cards {
    margin-top: clamp(32px, 5vw, 50px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BGX Content",
  "tag": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "void",
      "options": [
        { "value": "void", "label": "Deep navy" },
        { "value": "navy", "label": "Navy gradient" },
        { "value": "glow", "label": "Cyan glow" }
      ]
    },
    { "type": "checkbox", "id": "narrow", "default": true, "label": "Narrow column" },
    { "type": "checkbox", "id": "center", "default": false, "label": "Centre the heading" }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Rich text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text" }]
    },
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "sparkle",
          "options": [
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "flask", "label": "Flask" },
            { "value": "shield", "label": "Shield" },
            { "value": "award", "label": "Award" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "truck", "label": "Shipping" },
            { "value": "circulation", "label": "Circulation" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "prefix", "label": "Prefix" },
        { "type": "number", "id": "value", "label": "Value", "default": 15 },
        { "type": "number", "id": "decimals", "label": "Decimal places", "default": 0 },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "%" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    },
    {
      "type": "cta",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Shop BIO N:OV" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "BGX Content" }]
}
{% endschema %}
