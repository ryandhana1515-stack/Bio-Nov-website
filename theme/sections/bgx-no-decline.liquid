{% comment %}
  S2 · The Problem — motion moment M2.
  An SVG line chart draws itself on scroll as NO production falls from 100%
  at age 20 to 15% at 60+. Silhouettes desaturate and settle alongside, and
  the readout ticks down in sync. Controller: assets/vessel-scene.js.
{% endcomment %}

<section class="bgx-section bgx-section--glow" data-bgx-decline>
  <div class="bgx-wrap">
    <div class="bgx-decline__head">
      <span class="bgx-eyebrow bgx-reveal">{{ section.settings.eyebrow }}</span>
      <h2 class="bgx-h2" data-bgx-split>{{ section.settings.heading }}</h2>
      <p class="bgx-lead bgx-reveal" data-bgx-delay="0.1">{{ section.settings.body }}</p>
    </div>

    <div class="bgx-decline__chart bgx-reveal" data-bgx-delay="0.15">
      <div class="bgx-decline__readout" aria-hidden="true">
        <span class="bgx-num bgx-num--lg" data-bgx-decline-readout>100%</span>
        <span class="bgx-stat__label">{{ section.settings.readout_label }}</span>
      </div>

      <svg
        class="bgx-decline__svg"
        viewBox="0 0 600 300"
        role="img"
        aria-label="Chart: natural nitric oxide production falls from 100 percent at age 20 to about 15 percent at age 60 and over."
      >
        <defs>
          <linearGradient id="bgxDeclineStroke" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#00DCFF"/>
            <stop offset="45%" stop-color="#1F8BFF"/>
            <stop offset="100%" stop-color="#E63946"/>
          </linearGradient>
          <linearGradient id="bgxDeclineFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="rgba(0,220,255,.22)"/>
            <stop offset="100%" stop-color="rgba(0,220,255,0)"/>
          </linearGradient>
        </defs>

        {% comment %} Grid lines {% endcomment %}
        {%- assign grid_ys = '40,95,150,205,262' | split: ',' -%}
        {%- for gy in grid_ys -%}
          <line x1="30" x2="580" y1="{{ gy }}" y2="{{ gy }}" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
        {%- endfor -%}

        {% comment %} Area under the curve {% endcomment %}
        <path
          d="M40 40 C100 45 130 70 175 84 C230 100 260 130 310 150 C355 168 400 176 445 183 C490 192 535 212 570 227 L570 262 L40 262 Z"
          fill="url(#bgxDeclineFill)"
          opacity=".65"
        />

        {% comment %} The drawn line {% endcomment %}
        <path
          data-bgx-decline-path
          d="M40 40 C100 45 130 70 175 84 C230 100 260 130 310 150 C355 168 400 176 445 183 C490 192 535 212 570 227"
          fill="none"
          stroke="url(#bgxDeclineStroke)"
          stroke-width="3.5"
          stroke-linecap="round"
        />

        {% comment %} Stop markers + labels {% endcomment %}
        {%- assign xs = '40,175,310,445,570' | split: ',' -%}
        {%- assign ys = '40,84,150,183,227' | split: ',' -%}
        {%- assign ages = '20s,30s,40s,50s,60+' | split: ',' -%}
        {%- assign vals = '100%,80%,50%,35%,15%' | split: ',' -%}
        {%- for x in xs -%}
          {%- assign i = forloop.index0 -%}
          <g data-bgx-decline-dot style="opacity:0;transform-box:fill-box;transform-origin:center;transition:opacity .4s ease,transform .4s cubic-bezier(.16,1,.3,1)">
            <circle cx="{{ x }}" cy="{{ ys[i] }}" r="5.5" fill="#05070E" stroke="#00DCFF" stroke-width="2.5"/>
            <text x="{{ x }}" y="{{ ys[i] | minus: 16 }}" fill="#FFFFFF" font-size="15" font-weight="700" text-anchor="middle" font-family="'Space Grotesk',sans-serif">{{ vals[i] }}</text>
            <text x="{{ x }}" y="285" fill="#A9B7D0" font-size="13" text-anchor="middle" font-family="Inter,sans-serif">{{ ages[i] }}</text>
          </g>
        {%- endfor -%}
      </svg>

      <div class="bgx-decline__figures" aria-hidden="true">
        {%- for i in (1..3) -%}
          <svg class="bgx-decline__figure" data-bgx-figure viewBox="0 0 60 120" fill="none">
            <circle cx="30" cy="16" r="11" fill="#00DCFF" opacity=".85"/>
            <path d="M30 29c-9 0-15 6-15 14v26h30V43c0-8-6-14-15-14Z" fill="#1F8BFF" opacity=".75"/>
            <path d="M20 69h8v46h-8zM32 69h8v46h-8z" fill="#12256B" opacity=".9"/>
          </svg>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.source != blank -%}
      <p class="bgx-source bgx-reveal">Source: {{ section.settings.source }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .bgx-decline__head {
    max-width: 70ch;
    margin-bottom: clamp(30px, 5vw, 52px);
  }

  .bgx-decline__chart {
    position: relative;
    display: grid;
    gap: 26px;
    grid-template-columns: 1fr;
    align-items: center;
    padding: clamp(20px, 3vw, 34px);
    border-radius: var(--bgx-radius);
    border: 1px solid var(--bgx-glass-border);
    background: var(--bgx-glass);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .bgx-decline__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .bgx-decline__readout {
    position: absolute;
    top: clamp(16px, 3vw, 28px);
    right: clamp(16px, 3vw, 28px);
    text-align: right;
    z-index: 2;
  }

  .bgx-decline__readout .bgx-stat__label {
    display: block;
    max-width: 12ch;
    margin-left: auto;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .bgx-decline__figures {
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    gap: 18px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .bgx-decline__figure {
    width: clamp(38px, 8vw, 56px);
    height: auto;
    transition: filter 0.5s ease, transform 0.5s ease;
    transform-origin: bottom center;
  }

  @media (min-width: 860px) {
    .bgx-decline__chart {
      grid-template-columns: 1fr auto;
      gap: 40px;
    }
    .bgx-decline__figures {
      flex-direction: column;
      align-items: center;
      padding-top: 0;
      padding-left: 24px;
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.07);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BGX NO decline",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE PROBLEM" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "After 30, Your Body Stops Making Enough Nitric Oxide"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Nitric oxide keeps your blood vessels relaxed, broad and smooth. Production begins declining by about 20% every ten years — by age 60 most people have lost up to 85% of their natural NO production."
    },
    {
      "type": "text",
      "id": "readout_label",
      "label": "Readout label",
      "default": "Natural NO production"
    },
    { "type": "text", "id": "source", "label": "Source", "default": "Circulation" }
  ],
  "presets": [{ "name": "BGX NO decline" }]
}
{% endschema %}
