{% comment %}
  S11 · Certifications.
  Certificate images in glass frames, opened in a native <dialog> lightbox.
  Plus a badge row.

  Certificate scans must be uploaded and each certificate's validity verified
  before launch — the section ships with empty image slots by design.
{% endcomment %}

<section class="bgx-section bgx-section--navy">
  <div class="bgx-wrap">
    <div class="bgx-center">
      <span class="bgx-eyebrow bgx-reveal">{{ section.settings.eyebrow }}</span>
      <h2 class="bgx-h2" data-bgx-split>{{ section.settings.heading }}</h2>
      <span class="bgx-underline bgx-underline--center bgx-reveal"></span>
    </div>

    <div class="bgx-grid bgx-grid--4 bgx-cert__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'certificate' -%}
          <figure class="bgx-cert bgx-reveal" data-bgx-delay="{{ forloop.index0 | times: 0.08 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <button
                type="button"
                class="bgx-cert__btn"
                data-bgx-lightbox="{{ block.settings.image | image_url: width: 1600 }}"
                data-bgx-lightbox-alt="{{ block.settings.title | escape }}"
                aria-label="View {{ block.settings.title | escape }} full size"
              >
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    widths: '200,300,450,600',
                    sizes: '(min-width: 990px) 260px, 45vw',
                    alt: block.settings.title
                }}
              </button>
            {%- else -%}
              <div class="bgx-cert__empty">
                {% render 'bgx-icon', name: 'award' %}
                <span>Certificate image pending</span>
              </div>
            {%- endif -%}
            <figcaption>{{ block.settings.title }}</figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign badges = section.blocks | where: 'type', 'badge' -%}
    {%- if badges.size > 0 -%}
      <ul class="bgx-cert__badges bgx-reveal">
        {%- for block in badges -%}
          <li class="bgx-pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<dialog class="bgx-lightbox" data-bgx-lightbox-dialog aria-label="Certificate viewer">
  <button type="button" class="bgx-lightbox__close" data-bgx-lightbox-close aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <img alt="" data-bgx-lightbox-img>
</dialog>

<script>
  /* Certificate lightbox. Uses native <dialog> so focus trapping, Escape and
     the backdrop come free. */
  (function () {
    var dialog = document.querySelector('[data-bgx-lightbox-dialog]');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    var img = dialog.querySelector('[data-bgx-lightbox-img]');

    document.querySelectorAll('[data-bgx-lightbox]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        img.src = btn.dataset.bgxLightbox;
        img.alt = btn.dataset.bgxLightboxAlt || '';
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-bgx-lightbox-close]').addEventListener('click', function () {
      dialog.close();
    });

    /* Click on the backdrop (outside the image) closes. */
    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) dialog.close();
    });
  })();
</script>

{% stylesheet %}
  .bgx-cert__grid {
    margin-top: clamp(34px, 5vw, 56px);
  }

  .bgx-cert {
    margin: 0;
    padding: 14px;
    border-radius: var(--bgx-radius);
    border: 1px solid var(--bgx-glass-border);
    background: var(--bgx-glass);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition: transform 0.5s var(--bgx-ease-out), box-shadow 0.5s var(--bgx-ease-out),
      border-color 0.5s var(--bgx-ease-out);
  }

  .bgx-cert:hover,
  .bgx-cert:focus-within {
    transform: translateY(-5px);
    border-color: var(--bgx-glass-border-hi);
    box-shadow: var(--bgx-bloom);
  }

  .bgx-cert__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--bgx-radius-sm);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.9);
    cursor: zoom-in;
  }

  .bgx-cert__btn img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    display: block;
  }

  .bgx-cert__empty {
    display: grid;
    place-items: center;
    gap: 10px;
    aspect-ratio: 3 / 4;
    border-radius: var(--bgx-radius-sm);
    border: 1px dashed rgba(0, 220, 255, 0.25);
    color: rgba(169, 183, 208, 0.75);
    font-size: 0.8rem;
    text-align: center;
    padding: 12px;
  }

  .bgx-cert__empty svg {
    width: 30px;
    height: 30px;
    stroke: var(--bgx-cyan);
    fill: none;
    stroke-width: 1.4;
    opacity: 0.7;
  }

  .bgx-cert figcaption {
    margin-top: 12px;
    font-size: 0.88rem;
    color: var(--bgx-mist-strong);
    text-align: center;
  }

  .bgx-cert__badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: clamp(32px, 5vw, 50px) 0 0;
    padding: 0;
  }

  .bgx-lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 900px);
    max-height: 92vh;
    overflow: visible;
  }

  .bgx-lightbox::backdrop {
    background: rgba(5, 7, 14, 0.92);
    backdrop-filter: blur(8px);
  }

  .bgx-lightbox img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 92vh;
    object-fit: contain;
    border-radius: var(--bgx-radius);
  }

  .bgx-lightbox__close {
    position: absolute;
    top: -46px;
    right: 0;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--bgx-glass-border);
    background: rgba(5, 7, 14, 0.8);
    color: var(--bgx-white);
    cursor: pointer;
  }

  .bgx-lightbox__close svg {
    width: 18px;
    height: 18px;
  }
{% endstylesheet %}

