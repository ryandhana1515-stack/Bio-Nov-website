{% comment %}
  BIO N:OV — auto-rotating announcement bar.
  Messages are blocks so they can be added/removed in the Theme Editor.
{% endcomment %}

<div class="bgx-announce" data-bgx-announce>
  <div class="bgx-announce__inner">
    {%- for block in section.blocks -%}
      <div class="bgx-announce__item" data-bgx-announce-item {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          <span>{{ block.settings.text }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .bgx-announce {
    position: relative;
    z-index: 60;
    background: linear-gradient(90deg, #0b1b3a 0%, #12256b 50%, #0b1b3a 100%);
    border-bottom: 1px solid rgba(0, 220, 255, 0.14);
  }

  .bgx-announce__inner {
    position: relative;
    height: 40px;
    max-width: var(--bgx-maxw);
    margin-inline: auto;
    padding-inline: var(--bgx-gutter);
  }

  .bgx-announce__item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s var(--bgx-ease-out), transform 0.6s var(--bgx-ease-out);
    pointer-events: none;
    font-size: 0.8rem;
    letter-spacing: 0.045em;
    color: var(--bgx-mist-strong);
    text-align: center;
  }

  .bgx-announce__item.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .bgx-announce__item a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 220, 255, 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .bgx-announce__item {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BGX Announcement bar",
  "tag": "div",
  "class": "bgx-announce-section",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free worldwide shipping over $99"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BGX Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Free worldwide shipping over $99"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "GMP-Certified Korean Manufacturing"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Patented 3rd-Gen Fermentation Technology"
          }
        }
      ]
    }
  ]
}
{% endschema %}
