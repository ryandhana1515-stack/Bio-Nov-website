{% comment %}
  S15 · Final CTA.
  Full-bleed vessel-restore video under a dark overlay, big gradient CTA,
  guarantee badge and trust row.
{% endcomment %}

<section class="bgx-section bgx-finalcta">
  {% render 'bgx-video-bg',
    mp4: section.settings.video_mp4,
    webm: section.settings.video_webm,
    poster: section.settings.video_poster,
    opacity: section.settings.video_opacity,
    scrim: 'vignette'
  %}

  <div class="bgx-wrap bgx-center">
    <h2 class="bgx-h2" data-bgx-split>{{ section.settings.heading }}</h2>
    <p class="bgx-lead bgx-reveal" data-bgx-delay="0.1">{{ section.settings.subheading }}</p>

    <div class="bgx-finalcta__actions bgx-reveal" data-bgx-delay="0.2">
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link }}" class="bgx-btn bgx-btn--lg" data-bgx-magnetic>
          {{- section.settings.cta_text -}}
        </a>
      {%- endif -%}

      {%- if section.settings.guarantee_text != blank -%}
        <span class="bgx-finalcta__badge">
          <span class="bgx-finalcta__badge-icon" aria-hidden="true">
            {% render 'bgx-icon', name: 'shield' %}
          </span>
          {{ section.settings.guarantee_text }}
        </span>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="bgx-finalcta__trust bgx-reveal" data-bgx-delay="0.3">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .bgx-finalcta {
    background: var(--bgx-void);
    padding-block: clamp(100px, 14vw, 190px);
  }

  .bgx-finalcta .bgx-lead {
    margin-inline: auto;
  }

  .bgx-finalcta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 18px;
    margin-top: 2.2rem;
  }

  .bgx-finalcta__badge {
    display: inline-grid;
    grid-template-columns: auto 1fr;
    gap: 9px;
    align-items: center;
    padding: 0.7em 1.2em;
    border-radius: var(--bgx-radius-pill);
    border: 1px solid var(--bgx-glass-border);
    background: rgba(5, 7, 14, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.88rem;
    color: var(--bgx-mist-strong);
  }

  .bgx-finalcta__badge-icon {
    display: grid;
    place-items: center;
    color: var(--bgx-cyan);
  }

  .bgx-finalcta__badge-icon svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bgx-finalcta__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(12px, 3vw, 30px);
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    font-size: 0.84rem;
    color: rgba(169, 183, 208, 0.85);
  }

  .bgx-finalcta__trust li {
    position: relative;
  }

  .bgx-finalcta__trust li + li::before {
    content: '·';
    position: absolute;
    left: clamp(-16px, -1.5vw, -8px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BGX Guarantee CTA",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Background video"
    },
    {
      "type": "text",
      "id": "video_mp4",
      "label": "Video URL (MP4)",
      "info": "Slot: vessel-restore."
    },
    {
      "type": "text",
      "id": "video_webm",
      "label": "Video URL (WebM, optional)"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Poster image"
    },
    {
      "type": "range",
      "id": "video_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 45,
      "unit": "%",
      "label": "Video opacity"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay Healthy. Happy. In Harmony."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clearing the way to optimum health — from Korea to the world."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop BIO N:OV"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee badge",
      "default": "30-day money-back guarantee"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BGX Guarantee CTA",
      "blocks": [
        {
          "type": "trust",
          "settings": {
            "text": "GMP Certified Korea"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Free worldwide shipping over $99"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Ships from Singapore & Korea"
          }
        }
      ]
    }
  ]
}
{% endschema %}
