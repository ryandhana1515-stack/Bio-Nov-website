        "type": "ingredient",
        "settings": {
          "title": "Fermented Lettuce Extract",
          "fallback_asset": "bgx-lettuce-product.jpg",
          "body": "Vitamins A & B, amino acids; supports skin against aging."
        }
      },
      {
        "type": "ingredient",
        "settings": {
          "title": "Soybean",
          "body": "Vitamins, minerals and fiber; supports healthy cholesterol levels."
        }
      },
      {
        "type": "ingredient",
        "settings": {
          "title": "Soybean Sprouts",
          "body": "β-carotene and vitamin C; supports immune function."
        }
      },
      { "type": "spec", "settings": { "icon": "flask", "text": "500mg × 60 tablets (30g)" } },
      { "type": "spec", "settings": { "icon": "sparkle", "text": "3 tablets daily, 1 per serving" } },
