{% comment %}
  S1 · BIO N:OV Hero — motion moment M1.
  Full-bleed vessel flythrough behind a radial vignette, headline words rise
  on load, product box floats in from the right with a continuous bob.
{% endcomment %}

<section class="bgx-section bgx-hero" data-bgx-hero>
  {% render 'bgx-video-bg',
    mp4: section.settings.video_mp4,
    webm: section.settings.video_webm,
    poster: section.settings.video_poster,
    opacity: section.settings.video_opacity,
    scrim: 'vignette',
    eager: true
  %}

  <div class="bgx-wrap bgx-hero__grid">
    <div class="bgx-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="bgx-eyebrow bgx-reveal">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="bgx-h1 bgx-hero__title" data-bgx-split>{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="bgx-lead bgx-reveal" data-bgx-delay="0.15">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="bgx-btn-row bgx-reveal" data-bgx-delay="0.25">
        {%- if section.settings.cta_primary_text != blank -%}
          <a
            href="{{ section.settings.cta_primary_link | default: routes.all_products_collection_url }}"
            class="bgx-btn bgx-btn--lg"
            data-bgx-magnetic
          >
            {{ section.settings.cta_primary_text }}
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_text != blank -%}
          <a href="{{ section.settings.cta_secondary_link }}" class="bgx-btn bgx-btn--ghost bgx-btn--lg">
            {{- section.settings.cta_secondary_text -}}
          </a>
        {%- endif -%}
      </div>

      <ul class="bgx-trust bgx-reveal" data-bgx-delay="0.35">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust' -%}
            <li {{ block.shopify_attributes }}>
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5.5v6c0 4.7 3.3 9 8 10.5 4.7-1.5 8-5.8 8-10.5v-6L12 2Z"/><path d="m9 12 2 2 4-4"/></svg>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="bgx-hero__product bgx-reveal" data-bgx-delay="0.2">
      {%- if section.settings.product_image != blank -%}
        <div class="bgx-hero__box">
          {{
            section.settings.product_image
            | image_url: width: 900
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '300,500,700,900',
              sizes: '(min-width: 990px) 420px, 62vw',
              alt: section.settings.product_image_alt | default: 'BIO N:OV supplement box'
          }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_cue -%}
    <div class="bgx-hero__cue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .bgx-hero {
    min-height: min(100svh, 900px);
    display: flex;
    align-items: center;
    padding-block: clamp(60px, 10vw, 120px);
  }

  .bgx-hero__grid {
    display: grid;
    gap: clamp(30px, 6vw, 60px);
    align-items: center;
    grid-template-columns: 1fr;
    width: 100%;
  }

  .bgx-hero__title {
    margin-bottom: 1.3rem;
  }

  .bgx-hero__product {
    display: flex;
    justify-content: center;
    order: -1;
  }

  .bgx-hero__box {
    position: relative;
    max-width: min(420px, 68vw);
    animation: bgx-bob 5s ease-in-out infinite;
  }

  .bgx-hero__box img {
    display: block;
    width: 100%;
    height: auto;
    /* Cyan rim glow, tracing the product silhouette rather than its box. */
    filter: drop-shadow(0 0 34px rgba(0, 220, 255, 0.34))
      drop-shadow(0 22px 44px rgba(0, 0, 0, 0.55));
  }

  .bgx-hero__box::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -8%;
    width: 78%;
    height: 42px;
    transform: translateX(-50%);
    background: radial-gradient(50% 50% at 50% 50%, rgba(0, 220, 255, 0.32) 0%, transparent 72%);
    filter: blur(10px);
    z-index: -1;
  }

  @keyframes bgx-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  .bgx-hero__cue {
    position: absolute;
    left: 50%;
    bottom: 26px;
    translate: -50% 0;
    color: var(--bgx-cyan);
    animation: bgx-cue 2.1s ease-in-out infinite;
  }

  .bgx-hero__cue svg {
    width: 26px;
    height: 26px;
  }

  @keyframes bgx-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    50% {
      transform: translateY(8px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bgx-hero__box,
    .bgx-hero__cue {
      animation: none;
    }
  }

  @media (min-width: 990px) {
    .bgx-hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .bgx-hero__product {
      order: 0;
      justify-content: flex-end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BGX Hero",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Video background" },
    {
      "type": "text",
      "id": "video_mp4",
      "label": "Video URL (MP4)",
      "info": "Slot: hero-vessel-loop. Upload to Shopify Files (Content > Files) and paste the URL here."
    },
    { "type": "text", "id": "video_webm", "label": "Video URL (WebM, optional)" },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Poster image",
      "info": "Shown before the video loads, and instead of it under reduced-motion. Required for a good LCP."
    },
    {
      "type": "range",
      "id": "video_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 55,
      "unit": "%",
      "label": "Video opacity"
    },
    { "type": "header", "content": "Copy" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "KOREAN BIOTECH · 3RD GENERATION NITRIC OXIDE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clearing The Way To Optimum Health"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "BIO N:OV is a 3rd-generation nitric oxide supplement built on patented Korean microbial fermentation — supporting healthy blood pressure, blood sugar, energy, and vitality."
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_primary_text", "label": "Primary button", "default": "Shop BIO N:OV" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary link" },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary button",
      "default": "See The Science"
    },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Product" },
    { "type": "image_picker", "id": "product_image", "label": "Product image (transparent PNG)" },
    { "type": "text", "id": "product_image_alt", "label": "Product image alt text" },
    { "type": "checkbox", "id": "show_scroll_cue", "default": true, "label": "Show scroll cue" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "GMP Certified Korea" }]
    }
  ],
  "default": {
    "blocks": [
      { "type": "trust", "settings": { "text": "GMP Certified Korea" } },
      { "type": "trust", "settings": { "text": "US Patented Strain KACC91554P" } },
      { "type": "trust", "settings": { "text": "100% Natural Fermented Ingredients" } },
      { "type": "trust", "settings": { "text": "Zero Reported Side Effects" } }
    ]
  },
  "presets": [{ "name": "BGX Hero" }]
}
{% endschema %}
