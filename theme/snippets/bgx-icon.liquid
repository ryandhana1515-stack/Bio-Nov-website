{% comment %}
  BIO N:OV — inline icon set.
  Keeps icons out of the section files so they stay consistent everywhere.
  Accepts: name {String}. Falls back to a neutral spark.

  Usage: {% render 'bgx-icon', name: block.settings.icon %}
{% endcomment %}

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'brain' -%}
      <path d="M9.5 3A2.5 2.5 0 0 0 7 5.5 2.5 2.5 0 0 0 5 8a2.5 2.5 0 0 0 .5 1.5A2.5 2.5 0 0 0 5 12a2.5 2.5 0 0 0 1.5 2.3A2.5 2.5 0 0 0 9 18a2.5 2.5 0 0 0 3 2V3.5A2.5 2.5 0 0 0 9.5 3Z"/>
      <path d="M14.5 3A2.5 2.5 0 0 1 17 5.5 2.5 2.5 0 0 1 19 8a2.5 2.5 0 0 1-.5 1.5A2.5 2.5 0 0 1 19 12a2.5 2.5 0 0 1-1.5 2.3A2.5 2.5 0 0 1 15 18a2.5 2.5 0 0 1-3 2V3.5A2.5 2.5 0 0 1 14.5 3Z"/>
    {%- when 'heart' -%}
      <path d="M12 20.5s-7.5-4.6-7.5-9.8A4.2 4.2 0 0 1 12 8a4.2 4.2 0 0 1 7.5 2.7c0 5.2-7.5 9.8-7.5 9.8Z"/>
      <path d="M4.8 12.6h3.4l1.3-2.4 1.9 4.2 1.5-3 1 1.2h5.3"/>
    {%- when 'circulation' -%}
      <path d="M6 3v6a4 4 0 0 0 4 4h4a4 4 0 0 1 4 4v4"/>
      <path d="M18 3v4"/><path d="M6 21v-4"/>
      <circle cx="6" cy="3" r="1.6"/><circle cx="18" cy="21" r="1.6"/>
    {%- when 'immune' -%}
      <path d="M12 2 4 5.5v6c0 4.7 3.3 9 8 10.5 4.7-1.5 8-5.8 8-10.5v-6L12 2Z"/>
      <path d="M12 8v6"/><path d="M9 11h6"/>
    {%- when 'respiratory' -%}
      <path d="M12 4v7"/>
      <path d="M12 11c0-2-1.5-3.5-3.5-3.5S5 9 5 11c0 4 .5 7 2.5 8S12 18 12 15"/>
      <path d="M12 11c0-2 1.5-3.5 3.5-3.5S19 9 19 11c0 4-.5 7-2.5 8S12 18 12 15"/>
    {%- when 'digestive' -%}
      <path d="M8 3v5a4 4 0 0 0 4 4 4 4 0 0 1 4 4v2a3 3 0 0 1-6 0"/>
      <path d="M8 3h3"/>
    {%- when 'flask' -%}
      <path d="M9 2v6.5L4.5 17A2.5 2.5 0 0 0 6.8 21h10.4a2.5 2.5 0 0 0 2.3-4L15 8.5V2"/>
      <path d="M8 2h8"/><path d="M7 15h10"/>
    {%- when 'shield' -%}
      <path d="M12 2 4 5.5v6c0 4.7 3.3 9 8 10.5 4.7-1.5 8-5.8 8-10.5v-6L12 2Z"/>
      <path d="m9 12 2 2 4-4"/>
    {%- when 'bolt' -%}
      <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>
    {%- when 'leaf' -%}
      <path d="M4 20c0-8 5-14 16-15 0 11-6 16-13 16H4Z"/>
      <path d="M9 20c1-5 4-8 8-10"/>
    {%- when 'award' -%}
      <circle cx="12" cy="9" r="6"/>
      <path d="m9 14-1.5 7L12 19l4.5 2L15 14"/>
    {%- when 'truck' -%}
      <path d="M2 6h11v11H2z"/><path d="M13 9h4l4 4v4h-8"/>
      <circle cx="6.5" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/>
      <path d="m6.3 6.3 2.8 2.8M14.9 14.9l2.8 2.8M17.7 6.3l-2.8 2.8M9.1 14.9l-2.8 2.8"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8"/><path d="M12 8v8M8 12h8"/>
  {%- endcase -%}
</svg>
