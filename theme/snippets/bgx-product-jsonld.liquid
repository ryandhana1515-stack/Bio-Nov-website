{% comment %}
  BIO N:OV — Product structured data.

  The bgx product template does not use Dawn's main-product section, so the
  Product JSON-LD that normally ships with it is emitted here instead.
  Rendered once per page from bgx-offer-bundles.

  Accepts: bgx_product {Object}
{% endcomment %}

{%- if bgx_product != blank -%}
  {%- assign bgx_ld_image = bgx_product.featured_media | image_url: width: 1200 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ bgx_product.title | json }},
      "url": {{ request.origin | append: bgx_product.url | json }},
      {% if bgx_ld_image %}"image": [{{ bgx_ld_image | prepend: 'https:' | json }}],{% endif %}
      "description": {{ bgx_product.description | strip_html | truncate: 500 | json }},
      "brand": { "@type": "Brand", "name": {{ bgx_product.vendor | json }} },
      {% if bgx_product.selected_or_first_available_variant.sku != blank %}
        "sku": {{ bgx_product.selected_or_first_available_variant.sku | json }},
      {% endif %}
      "offers": [
        {%- for variant in bgx_product.variants -%}
          {
            "@type": "Offer",
            "name": {{ variant.title | json }},
            "url": {{ request.origin | append: bgx_product.url | append: '?variant=' | append: variant.id | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
